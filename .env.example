# ---- Free LLM providers ----
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# ---- Models as "provider:model" (check each console for current free models) ----
GENERATOR_MODEL=groq:openai/gpt-oss-120b
JUDGE_MODEL=google_genai:gemini-3.5-flash
FALLBACK_MODEL=openrouter:recursive/flint-v1.0:free

# ---- LangSmith (free Developer plan) ----
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=testgen-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
